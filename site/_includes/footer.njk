    <p>{% if doc.language == "fr" %}Polices : {% else %}Fonts: {% endif %}<a href="https://fonts.google.com/">Google Fonts</a> · <a href="https://policies.google.com/privacy">{% if doc.language == "fr" %}Confidentialité Google{% else %}Google privacy{% endif %}</a></p>
    {% include "footer-extra.njk" %}
  </div>
</footer>
