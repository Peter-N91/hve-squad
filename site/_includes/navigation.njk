{% for group in doc.nav %}
<div class="nav-section">
  <p class="nav-group">{{ group.label }}</p>
  {% for item in group.pages %}<a class="nav-link{% if item.subpage %} nav-subpage{% endif %}" href="{{ item.url }}"{% if item.id == doc.slug %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
</div>
{% endfor %}
